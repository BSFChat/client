<?xml version="1.0"?>
<!--
  Application id: com.bsfchat.app.

  Google Play locks the application id PERMANENTLY at first upload —
  it can never be changed for the life of the listing. It therefore
  has to match BSFCHAT_BUNDLE_ID (CMakeLists.txt) before anything is
  pushed to the Play Console, not after.

  This `package` attribute is how Qt 6.5-era androiddeployqt (AGP
  7.x) learns the id. AGP 8 (Qt 6.8+) ignores it and reads
  `namespace` out of gradle.properties instead, which is why
  CMakeLists.txt also sets QT_ANDROID_PACKAGE_NAME on Qt >= 6.8.
  Both must stay in sync; the CI job asserts the built artefact's id.

  Note the Java classes stay in package com.bsfchat.client. The
  application id and the Java package are independent, no app-level
  R class is referenced anywhere in android/src (only framework
  android.R.drawable), and every component below is named by its
  fully-qualified class, so nothing needs moving.
-->
<!--
  The two version placeholders below must match Qt's own template
  (qtbase/src/android/templates/AndroidManifest.xml) EXACTLY, including
  the trailing space-dash-dash. They were previously written without it,
  androiddeployqt did not recognise them, and the QT_ANDROID_VERSION_CODE
  and QT_ANDROID_VERSION_NAME properties set in CMakeLists.txt were
  silently discarded: the last Android build to come out of this tree
  carried versionCode 1 / versionName 1.0 regardless of the release it
  was cut from. Leaving them unsubstituted is a hard Gradle failure
  (NumberFormatException on applicationId). Either way, do not reformat.

  (And note this file is parsed as strict XML by androiddeployqt before
  Gradle ever sees it, so no comment in it may contain a double dash.)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bsfchat.app"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Foreground-service plumbing so the OS doesn't kill the
         process mid-voice-call while the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Camera FGS permission — Android 14+ requires this in
         addition to CAMERA whenever the camera is used from a
         foreground service. VoiceService declares type
         "microphone|camera" so a single FGS anchors both uses
         during a call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Allow the foreground-service notification to appear on
         Android 13+ which gates all notification posting behind
         a runtime opt-in. We request this lazily before first
         voice-join (see AndroidPermissions). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep wake during a call so the OS doesn't doze us off the
         network mid-conversation. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      REMOVED, deliberately — do not re-add without a caller:

      WRITE_EXTERNAL_STORAGE — a no-op since scoped storage (API 29)
      and fully ignored from API 33. Nothing under src/ or android/
      touches external storage; downloads go through SAF/the app's
      own sandbox. Keeping it costs a Play Console "sensitive
      permission" justification for a permission we never exercise.
      android:requestLegacyExternalStorage went with it (it only ever
      had meaning on API 29/30 alongside that permission).

      BLUETOOTH — the legacy (maxSdkVersion 30) permission. Grep for
      Bluetooth APIs in android/src and src/ finds none: the only
      hits are desktop AudioDevicePolicy comments about headset
      hot-plug debouncing. Routing call audio to an already-paired
      BT headset is done through AudioManager (MODIFY_AUDIO_SETTINGS)
      and needs no Bluetooth permission at all. If we ever want to
      *enumerate* BT devices we need BLUETOOTH_CONNECT (API 31+) and
      a runtime prompt — a different permission with a different
      justification, so this one would not have helped anyway.
    -->

    <!--
      Play derives implied <uses-feature> requirements from
      permissions: CAMERA implies android.hardware.camera required,
      RECORD_AUDIO implies android.hardware.microphone required.
      Left implicit, Play would hide the listing from every device
      without a camera — and BSFChat is a perfectly good text client
      on such a device. Declare them optional and let the runtime
      permission flow deal with absence.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="BSFChat"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="false"
        android:fullBackupOnly="false">
        <!--
          allowBackup="false": Android Auto Backup would copy this
          app's private data dir — which holds the OIDC refresh token,
          the access token and the homeserver session state — into the
          user's Google Drive, silently and unencrypted-to-us. That is
          both a credential-exfiltration path we don't control and a
          direct contradiction of the project's own-your-server
          promise. Was "true" (Qt's template default) until the Play
          hardening pass; it has never shipped to a store.
        -->
        <!--
          screenOrientation="portrait" — PORTRAIT ONLY, deliberately, for
          the first release. This is the Android half of the decision
          recorded at length in ios/Info.plist.in's
          UISupportedInterfaceOrientations; read that comment for the
          reasoning and the numbers.

          Short version: there is no orientation-aware code in qml/ at
          all, every phone surface is a vertical stack sized for a
          portrait viewport, and with the software keyboard up a
          landscape phone leaves well under a hundred dp for the message
          list. "unspecified" (Qt's template default) let the device
          rotate into a layout that had never been looked at.

          Two things this does NOT do, both fine for a phone-first first
          release but worth knowing:

            • targetSdk is 36 (CMakeLists.txt BSFCHAT_ANDROID_TARGET_SDK).
              From Android 16, screenOrientation is IGNORED on displays
              whose smallest width is >= 600dp, so tablets, unfolded
              foldables and Chromebooks will still rotate this app. They
              are not a launch target; when they become one the answer is
              a landscape layout, not a manifest attribute.
            • configChanges below still lists orientation|screenSize, so
              a rotation that does happen anyway is handled in-process
              rather than by recreating the activity — which would take
              the live voice session down with it.
        -->
        <activity
            android:name="com.bsfchat.client.BSFChatActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:label="BSFChat"
            android:theme="@style/Theme.BSFChat.Splash"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- bsfchat:// deep links, and the OIDC sign-in callback.
                 BROWSABLE is what lets a browser hand the URL back to
                 us, which is the whole point here: the sign-in used to
                 redirect to a loopback port this app listens on, and
                 that can never arrive on Android — Qt's Android event
                 dispatcher stops servicing socket notifiers the moment
                 the activity pauses, so the browser's connection sits
                 unaccepted in the backlog until the user comes back by
                 hand. The provider now redirects to
                 bsfchat://oauth/callback and the OS resolves it here.

                 Host-scoped to "oauth" deliberately: this filter exists
                 for the sign-in, and claiming the bare scheme would
                 also claim every message deep link for an intent path
                 that has no reason to handle them. The activity is
                 already singleTop, so the redirect resumes the running
                 instance rather than stacking a second copy, and
                 onNewIntent -> nativeOnNewIntent -> UrlHandler
                 ::checkAndroidLaunchIntent picks it up. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bsfchat" android:host="oauth" />
            </intent-filter>

            <!-- Share target: let other apps "Share to BSFChat" a
                 single file or snippet of text. We handle the intent
                 on the Qt side (UrlHandler) by reading the activity
                 intent at launch and, if it's ACTION_SEND, uploading
                 the payload to the user's current channel. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>

          <meta-data
                android:name="android.app.lib_name"
                android:value="bsfchat-app" />

          <meta-data
                android:name="android.app.arguments"
                android:value="" />

            <meta-data
                android:name="android.app.extract_android_style"
                android:value="minimal" />
        </activity>

        <!-- Foreground service anchors the process while the user
             is in a voice channel — without this Android 8+ will
             kill the backgrounded app and drop the call the moment
             the user switches to another app. Declared with
             foregroundServiceType="microphone" so Android 14+
             permission checks find the matching FGS permission. -->
        <service
            android:name="com.bsfchat.client.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />
        <!-- Sync service — keeps the Matrix /sync alive so inbound
             messages can fire Android notifications while the app
             is backgrounded. Low-priority ongoing notification so
             users know we're there (and can turn us off via channel
             settings if they don't want background sync). -->
        <service
            android:name="com.bsfchat.client.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Screen-share foreground service — the MediaProjection
             API requires a foreground service with
             foregroundServiceType="mediaProjection" on Android 10+,
             and a matching FOREGROUND_SERVICE_MEDIA_PROJECTION
             permission on 14+. Without both the platform throws
             SecurityException the moment we try to create the
             VirtualDisplay. -->
        <service
            android:name="com.bsfchat.client.MediaProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
