# Build directories (CMake out-of-tree). Covers build/, build-ios-device/,
# build-ios-simulator/, build-android/, build-android-arm64/, etc.
build/
build-*/

# CMake incremental / tooling artefacts
.cache/
compile_commands.json
CMakeUserPresets.json

# Vendored prebuilts — rebuilt via scripts/, not committed
deps/

# macOS metadata
.DS_Store

# Tooling logs — aqtinstall.log from the Qt installer, CMake/ninja output etc.
*.log

# Editor noise
*.swp
*~
.vscode/
.idea/

# Signed APKs / installers etc. live in /tmp by convention; guard anyway.
# *.idsig is apksigner's detached v4 signature, emitted next to the APK.
# *.jks is the PKCS12 form keytool produces for the Play upload key —
# that one must NEVER reach the repo (see docs/android-release.md).
*.apk
*.aab
*.idsig
*.keystore
*.jks
artifacts/

# iOS signing material and archives. The .p8 App Store Connect key in
# particular is downloadable exactly once and grants upload rights to
# the whole team — it lives in a GitHub secret (see docs/ios-release.md),
# never on disk here. Archives and .ipas are build output.
*.ipa
*.xcarchive/
*.p12
*.p8
*.mobileprovision

# macOS iconset is an intermediate dir consumed by iconutil to produce
# branding/BSFChat.icns — regenerate with branding/generate_icons.py.
branding/BSFChat.iconset/
