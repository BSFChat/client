<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for `xcodebuild -exportArchive`, consumed by the `ios` job in
  .github/workflows/ci.yml. The @PLACEHOLDERS@ are the account- and
  run-specific values, which is why this is a .in rather than a finished
  file.

  A local export can use it the same way:
    sed -e "s/@APPLE_TEAM_ID@/ABCDE12345/" \
        -e "s/@EXPORT_DESTINATION@/export/" \
        -e "s/@SIGNING_CERTIFICATE@/Apple Distribution/" \
        -e "s/@PROVISIONING_PROFILE@/<profile uuid or name>/" \
        ios/ExportOptions.plist.in > /tmp/eo.plist
-->
<plist version="1.0">
<dict>
	<!-- "app-store-connect" is the current spelling; Xcode 15.3 and
	     earlier called it "app-store". Xcode still accepts the old name
	     but warns, and only this method produces an .ipa that App Store
	     Connect will take — "development" or "ad-hoc" archives are
	     signed with the wrong profile type and are rejected on upload. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>@APPLE_TEAM_ID@</string>

	<!-- Manual, and deliberately so. This used to say "automatic",
	     which let Xcode mint whatever signing assets it decided were
	     missing using the App Store Connect API key — and because a CI
	     runner's keychain starts empty every time, what it decided was
	     missing was a CERTIFICATE, on every single run, until the
	     account hit Apple's limit and the archive failed with "Choose a
	     certificate to revoke". `man xcodebuild` on
	     -allowProvisioningUpdates spells out the difference: automatic
	     signing "will create and update profiles, app IDs, and
	     certificates"; manual signing only downloads profiles. So the
	     pipeline is manual end to end, and the CI job does not pass
	     -allowProvisioningUpdates to any build, archive or export
	     action at all. The profile is fetched read-only beforehand by
	     scripts/asc-provisioning.py.

	     The cost is that the App Store profile has to exist in the
	     account, created once by a human. That is the intended trade:
	     CI can use signing assets and can never create them. -->
	<key>signingStyle</key>
	<string>manual</string>

	<!-- The exact certificate, by SHA-1 fingerprint, not by the display
	     name "Apple Distribution". Two certificates issued to the same
	     person share a display name, so a name would not pin anything —
	     and pinning it is the whole point. Substituted from the
	     fingerprint of the .p12 in the IOS_DIST_CERTIFICATE secret,
	     which the import step prints. -->
	<key>signingCertificate</key>
	<string>@SIGNING_CERTIFICATE@</string>

	<!-- Bundle id -> profile, required by manual signing. The value is
	     the UUID of the profile downloaded from App Store Connect
	     earlier in the job, so the export re-signs with the same
	     profile the archive embedded. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.bsfchat.app</key>
		<string>@PROVISIONING_PROFILE@</string>
	</dict>

	<!-- Upload the dSYMs so App Store Connect can symbolicate crash
	     reports from testers. This is the ONLY diagnostic channel the
	     client has — there is no crash reporter and no telemetry in the
	     app (deliberately), so a TestFlight crash log is all anyone
	     will ever get. It is also not "data collection" for privacy
	     nutrition-label purposes: Apple gathers it, we never do. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- export (write an .ipa next to the archive) or upload (send it
	     straight to App Store Connect). Templated because the CI job
	     renders this file twice: once to produce the artefact a human
	     can download and inspect, once to hand the same archive to
	     Apple. A local export leaves it as "export". -->
	<key>destination</key>
	<string>@EXPORT_DESTINATION@</string>

	<!-- Xcode's default for this is YES, and YES means Xcode rewrites
	     CFBundleVersion during distribution. We set the build number
	     deliberately from the workflow run number (see the ios job's
	     "Derive version" step) precisely because it has to be unique
	     and monotonic across uploads, so Xcode must not touch it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>

	<!-- Deliberately NOT set: `thinning`. `xcodebuild -help` documents
	     it as "For non-App Store exports", and an app-store-connect
	     export must hand Apple one universal package — Apple does the
	     thinning on its side, per device, at download time. The earlier
	     value here was <thin-for-all-variants>, which for a non-store
	     method makes exportArchive emit a DIRECTORY of per-variant
	     .ipa files; combined with the CI step's `find -name '*.ipa' |
	     head -1` that would have picked an arbitrary thinned variant
	     and uploaded it. Also not set: `uploadBitcode`, which Xcode 26
	     no longer lists as a valid key at all. -->
</dict>
</plist>
